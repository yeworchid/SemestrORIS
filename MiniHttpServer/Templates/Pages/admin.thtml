<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Админка</title>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 1200px;
            margin: 20px auto;
            padding: 20px;
        }
        .header {
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        .info {
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }
        tr:hover {
            background: #f5f5f5;
        }
        .edit-btn {
            padding: 8px 15px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
        }
        .modal-content {
            background: white;
            margin: 10% auto;
            padding: 30px;
            border-radius: 10px;
            width: 500px;
        }
        .close {
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }
        input, textarea {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .save-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Панель администратора</h1>
        <p>${message}</p>
    </div>
    
    <div class="info">
        <h3>Информация о пользователе:</h3>
        <p><strong>Email:</strong> ${user.Email}</p>
        <p><strong>Роль:</strong> ${user.Role}</p>
    </div>

    <h2>Список туров</h2>
    <table>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Описание</th>
            <th>Цена</th>
            <th>Действия</th>
        </tr>
        $foreach(var tour in tours)
        <tr>
            <td>${tour.Id}</td>
            <td>${tour.Title}</td>
            <td>${tour.ShortDescription}</td>
            <td>${tour.BasePrice}€</td>
            <td>
                <button class="edit-btn" onclick='openEdit(${tour.Id}, `${tour.Title}`, `${tour.ShortDescription}`, `${tour.FullDescription}`, ${tour.BasePrice})'>
                    Редактировать
                </button>
            </td>
        </tr>
        $endfor
    </table>

    <!-- Модалка для редактирования -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEdit()">&times;</span>
            <h2>Редактировать тур</h2>
            <input type="hidden" id="tourId">
            <label>Название:</label>
            <input type="text" id="tourTitle">
            <label>Краткое описание:</label>
            <textarea id="tourDesc" rows="3"></textarea>
            <label>Полное описание:</label>
            <div id="editor" style="height: 300px; background: white;"></div>
            <label>Цена:</label>
            <input type="number" id="tourPrice" step="0.01">
            <button class="save-btn" onclick="saveTour()">Сохранить</button>
        </div>
    </div>

    <script>
        // инициализируем Quill
        var quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link'],
                    ['clean']
                ]
            }
        });

        function openEdit(id, title, desc, fullDesc, price) {
            document.getElementById('tourId').value = id;
            document.getElementById('tourTitle').value = title;
            document.getElementById('tourDesc').value = desc;
            document.getElementById('tourPrice').value = price;
            
            // устанавливаем контент в Quill
            quill.root.innerHTML = fullDesc;
            
            document.getElementById('editModal').style.display = 'block';
        }

        function closeEdit() {
            document.getElementById('editModal').style.display = 'none';
        }

        function saveTour() {
            const data = {
                id: parseInt(document.getElementById('tourId').value),
                title: document.getElementById('tourTitle').value,
                shortDescription: document.getElementById('tourDesc').value,
                fullDescription: quill.root.innerHTML,
                basePrice: parseFloat(document.getElementById('tourPrice').value)
            };

            fetch('/admin/edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(result => {
                if (result.success) {
                    alert('Тур обновлен!');
                    location.reload();
                } else {
                    alert('Ошибка: ' + result.message);
                }
            })
            .catch(err => alert('Ошибка: ' + err));
        }
    </script>
</body>
</html>
