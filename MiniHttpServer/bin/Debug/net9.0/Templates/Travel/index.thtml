        <div class="container footer-grid">
            <div class="footer-column">
                <h4>ОСТАВАЙТЕСЬ НА СВЯЗИ</h4>
                <p>
                    <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/ico-42.png" alt="">
                    Запрос по электронной почте
                </p>
                <p>
                    <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/ico-44.png" alt="">
                    +49.173.153.70.36
                </p>
            </div>

            <div class="footer-column">
                <h4>ИНФОРМАЦИЯ</h4>
                <a href="#">Наши эксперты говорят</a>
            </div>

            <div class="footer-column">
                <h4>НАША ГОРДОСТЬ</h4>
                <a href="#">Тур в Диснейленд в Париже или все музеи</a>
            </div>

            <div class="footer-column">
                <h4>НАПРАВЛЕНИЯ</h4>
                <a href="#">Туры во Францию</a><br>
                <a href="#">Туры в Швейцарию</a><br>
                <a href="#">Туры в Англию</a>
            </div>

            <div class="footer-column logo-column">
                <img class="logo" src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/logo-3.png" alt="Kompass Logo">
                <div class="social-icons">
                    <a href="#"><i class="fa fa-facebook"></i></a>
                    <a href="#"><i class="fa fa-google"></i></a>
                    <a href="#"><i class="fa fa-twitter"></i></a>
                    <a href="#"><i class="fa fa-vk"></i></a>
                    <a href="#"><i class="fa fa-odnoklassniki"></i></a>
                </div>
                <h5>ТИПЫ ПЛАТЕЖЕЙ</h5>
                <img class="payments" src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/logos/logos-9.png" alt="Payment Types">
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container">
            <div class="footer-links">
                <a href="#">Правила обращения с личными данными</a> |
                <a href="#">Ч.З.В.</a> |
                <a href="#">Политика конфиденциальности</a> |
                <a href="#">Условия использования сайта</a> |
                <a href="#">Способы оплаты</a>
            </div>
            <p>© UAB "Komfort Europa" 2001–2022. Все права защищены.</p>
            <p>
                Все права на этот сайт являются собственностью UAB "Komfort Europa", VAT 304424056. Авторские права на отдельные части сайта, включая, но не ограничиваясь, коды, видео, некоторые авторские фотографии, совместно или индивидуально защищенные в соответствии с законом. Никакая часть этого сайта не может использоваться и распространяться без предварительного письменного разрешения UAB "Komfort Europa".
            </p>
        </div>
    </div>
</footer>

<script src="script.js"></script>
<script>
function validateEmail() {
    var email = document.getElementById('emailInput').value;
    
    // проверка на наличие @ и точки
    if (email.indexOf('@') === -1 || email.indexOf('.') === -1) {
        alert('Пожалуйста, введите правильный адрес электронной почты');
        return false;
    }
    
    // проверка что @ не в начале и не в конце
    if (email.indexOf('@') === 0 || email.indexOf('@') === email.length - 1) {
        alert('Пожалуйста, введите правильный адрес электронной почты');
        return false;
    }
    
    // проверка что есть текст после @
    var parts = email.split('@');
    if (parts.length !== 2 || parts[1].indexOf('.') === -1) {
        alert('Пожалуйста, введите правильный адрес электронной почты');
        return false;
    }
    
    return true;
}

function checkTourNameLength() {
    var input = document.getElementById('tourNameInput');
    var error = document.getElementById('tourNameError');
    
    // считаем символы
    if (input.value.length > 10) {
        error.style.display = 'block';
        input.style.borderColor = 'red';
    } else {
        error.style.display = 'none';
        input.style.borderColor = '';
    }
}

function validateTourSearch() {
    var input = document.getElementById('tourNameInput');
    
    // проверяем длину перед отправкой
    if (input.value.length > 10) {
        alert('Слишком много символов в названии тура! Максимум 10 символов.');
        return false;
    }
    
    return true;
}
</script>
</body>
</html>
