                        <div>
                            <i class="flag-icon flag-icon-ru"></i>
                            RU
                            <i class="fa fa-angle-down"></i>
                        </div>
                    </li>
                    <li>
                        <a href="#">
                            <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/user-menu/ico-3.png" alt="">
                            <span style="font-weight: bold">Мое бронирование</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/user-menu/ico-1.png" alt="">
                            <span>Где приобрести тур</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/user-menu/ico-2.png" alt="">
                            <span>О нас</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/user-menu/ico-3.png" alt="">
                            <span>Ч.З.В.</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/user-menu/ico-4.png" alt="">
                            <span>Контакты</span>
                        </a>
                    </li>
                </ul>
                <div class="user-menu-phone">
                    Звоните пн-пт 9.00-18.00, сб 9.00-14.00:
                    <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/de.png" alt=""> +49 173 153 7036 &nbsp;
                </div>
            </div>
        </div>
    </div>
    <div class="main-menu">
        <div class="container">
            <ul class="menu">
                <li>
                    <a href="#">
                        <span>Однодневные туры</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <span>Mногодневные туры</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <span>Шок-предложения!</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <span>Covid-19 информация</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <span>Отдых на море и экскурсии</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<div id="page">
    <section class="only-breadcrumb">
        <div class="container">
            <ul class="breadcrumb">
                <li class="breadcrumb-item link">
                    <a href="#">Главная</a>
                </li>
                <li class="breadcrumb-item">
                    <span>Однодневные туры</span>
                </li>
            </ul>
        </div>
    </section>


        <div class="container">
            <h1 class="f-30">Однодневные туры</h1>
        </div>


    <section class="orange p-3 text-center text-white">
        <span class="f-24">Быстрый поиск туров </span>
        <span class="f-16">(пожалуйста выберите параметры):</span>
    </section>

    <section class="search-form-wrapper other">
        <form method="get" action="#" onsubmit="return validateTourSearch()">
            <div class="container">
                <div class="row">
                    <div class="col-sm col-12">
                        <div class="form-group inline-label">
                            <label for="" class="simple w85">Тип тура</label>
                            <div>
                                <select class="form-control">
                                    <option value="">Bсе типы</option>
                                    <option value="1">Однодневные туры</option>
                                    <option value="2">Mногодневные туры</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm col-12">
                        <div class="form-group inline-label">
                            <label for="" class="simple w85">выбор страны</label>
                            <div>
                                <select class="form-control" name="country">
                                    <option value="">Все страны</option>
                                    <option value="1">Нидерланды</option>
                                    <option value="2">Бельгия</option>
                                    <option value="3">Люксембург</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-5 col-12">
                        <div class="form-group inline-label">
                            <label for="" class="simple w85">выбор по названию тура</label>
                            <div>
                                <input type="text" id="tourNameInput" placeholder="задать название тура" class="form-control" maxlength="10" oninput="checkTourNameLength()" />
                                <small id="tourNameError" style="color: red; display: none;">Слишком много символов (максимум 10)</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm col-12">
                        <div class="form-group date inline-label">
                            <label for="" class="simple w85">дата от</label>
                            <div>
                                <input type="date" name="date_from" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm col-12">
                        <div class="form-group date inline-label">
                            <label for="" class="simple w85">дата до</label>
                            <div>
                                <input type="date" name="date_to" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-5 col-12">
                        <div class="row">
                            <div class="col-sm col-12">
                                <div class="form-group inline-label">
                                    <label for="" class="simple w85">город отправления</label>
                                    <div>
                                        <select class="form-control" name="departure_city">
                                            <option value="">Все</option>
                                            <option value="1">Дюссельдорф</option>
                                            <option value="2">Кёльн</option>
                                            <option value="3">Эссен</option>
                                            <option value="4">Ахен</option>
                                            <option value="5">Дортмунд</option>
                                            <option value="6">Бонн</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-5">
                                <div class="form-group inline-label">
                                    <label for="" class="dummy">&nbsp;</label>
                                    <div>
                                        <button type="submit" class="btn btn-primary">
                                            <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/ico-27.png" alt="">
                                            Поиск
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </section>



    <section class="pt-35 pb-35">
        <div class="container">
            <ul class="results-list">


            $foreach(var tour in tours)
                <li class="result-item list">
                    <div class="img-block">
                        <a href="/travel?id=${tour.Id}" class="img-wrapper">
                            <img src="https://www.kompass-komfort.de${tour.CoverImageUrl}" alt="${tour.Title}" class="cover">
                        </a>
                        <div class="price-block">
                            от <span class="price">${tour.BasePrice} €</span>
                        </div>
                    </div>
                    <div class="cont">
                        <div>
                            <a href="/travel?id=${tour.Id}" class="title">${tour.Title}</a>
                            <div class="text">
                                <p><em>${tour.ShortDescription}</em></p>
                            </div>
                        </div>
                        <div class="text-right">
                            <a href="/travel?id=${tour.Id}" class="btn btn-md btn-primary f-12">
                                Подробнее <i class="fa fa-angle-right"></i>
                            </a>
                        </div>
                    </div>
                    <div class="dates">
                        <div>
                            <span class="block-title">${tour.Duration} день</span>
                            <div class="dates-list">
                                <div class="text-nowrap">${tour.Date1}</div>
                                <div class="text-nowrap">${tour.Date2}</div>
                                <div class="text-nowrap">${tour.Date3}</div>
                            </div>
                            <span class="more-dates-modal-trigger text-nowrap">
                                <span class="text">Больше дат </span> <i class="fa fa-plus-circle"></i>
                            </span>
                        </div>
                    </div>
                    <div class="booking-block">
                        <form method="post" action="/order">
                            <input type="hidden" name="tourId" value="${tour.Id}" />
                            <span class="block-title">Быстрый просчет базовой стоимости:</span>
                            <div class="form-group other inline-label">
                                <label for="" class="simple w85">Выберите дату</label>
                                <div>
                                    <select class="form-control" name="date" required>
                                        <option value="">Выберите дату</option>
                                        ${tour.DatesOptionsHtml}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group other inline-label">
                                <label for="" class="simple w85">Выберите город отправления</label>
                                <div>
                                    <select class="form-control" name="city" required>
                                        <option value="">Выберите город</option>
                                        <option value="1">Дюссельдорф</option>
                                        <option value="2">Кёльн</option>
                                        <option value="3">Эссен</option>
                                        <option value="4">Ахен</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group other inline-label">
                                <label for="" class="simple w85">Ваша базовая стоимость</label>
                                <div>
                                    <div class="row gutter-6">
                                        <div class="col">
                                            <span class="f-white f-19 font-weight-bold bg-orange p-5 text-nowrap">${tour.BasePrice} €</span>
                                        </div>
                                        <div class="col">
                                            <button type="submit" class="btn btn-md btn-primary f-12 red full-w">
                                                ЗАКАЗАТЬ <i class="fa fa-angle-right"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </li>
            $endfor


            </ul>
        </div>
    </section>
</div>

<footer class="footer">
