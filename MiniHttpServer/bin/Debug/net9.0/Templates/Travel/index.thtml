<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Однодневные туры из Германии по Европе</title>
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <link rel="icon" type="image/png" href="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/favicon.ico"/>
    <link href="https://fonts.googleapis.com/css?family=Philosopher:400,700&subset=cyrillic,cyrillic-ext" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body class="customer">


<header class="simple">
    <div class="container">
        <div class="cont">
            <div class="logo-wrap">
                <a href="#" class="logo"></a>
            </div>
            <div>
