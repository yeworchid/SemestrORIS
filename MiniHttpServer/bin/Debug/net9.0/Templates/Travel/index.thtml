            </div>
            <form class="newsletter-form" action="send" method="post" onsubmit="return validateEmail()">
                <input type="email" id="emailInput" name="email" placeholder="Введите ваш адрес электронной почты" required />
                <button type="submit">
                    <img src="https://www.kompass-komfort.de/bundles/applicationsonataproject/images/icons/ico-46.png" alt="Отправить">
                </button>
            </form>
        </div>
    </div>

